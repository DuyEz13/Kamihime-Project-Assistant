# Copy this file to .env. Defaults already live in code, so only configure the
# services and overrides you actually use. Never commit real credentials.

# Chatbot: choose one provider and uncomment its matching credentials.
KAMI_CHAT_PROVIDER=gpt

# OPENAI_API_KEY=your_openai_api_key
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional local Qwen translation. Install it with:
# uv sync --extra translation
# KAMI_TRANSLATION_PROVIDER=qwen
# KAMI_TRANSLATION_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
# KAMI_TRANSLATION_DEVICE=cuda

# Optional API translation alternatives.
# KAMI_TRANSLATION_PROVIDER=deepl
# DEEPL_AUTH_KEY=your_deepl_api_key
# DEEPL_GLOSSARY_ID=existing_deepl_glossary_id

# KAMI_TRANSLATION_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# Select this only when rendered pages should prefer a different translation
# provider from the one used for new translation jobs.
# KAMI_RENDER_TRANSLATION_PROVIDER=deepl

# Optional crawler overrides. Increase these two values if the source wiki
# starts returning HTTP 429 responses.
# KAMI_REQUEST_INTERVAL=2.0
# KAMI_HTTP_429_COOLDOWN=90
# KAMI_SOURCE_URL_KAMIHIME_FIRE=https://wikiwiki.jp/...
# KAMI_SOURCE_URL_EIDOLON_PHANTOM=https://wikiwiki.jp/...
# KAMI_SOURCE_URL_WEAPON_PHANTOM=https://wikiwiki.jp/...

# Shared RAG device override. Local automatic builds explicitly require CUDA.
# KAMI_RAG_DEVICE=cuda
# Local batch size is conservative for a laptop with 4 GB VRAM.
KAMI_LOCAL_RAG_BATCH_SIZE=8
# Reuse document vectors across immutable index builds. The limit is the logical
# vector payload budget; SQLite file overhead can make the file somewhat larger.
KAMI_LOCAL_RAG_EMBED_CACHE=1
KAMI_LOCAL_RAG_EMBED_CACHE_MAX_MB=128
# Keep query embeddings/reranking on CPU while GPU builds run.
KAMI_LOCAL_RAG_QUERY_DEVICE=cpu
# Maximum durable local pipeline run summaries to retain.
KAMI_LOCAL_RUN_HISTORY=100

# Advanced crawler, translation, chat, tracing, and RAG tuning options are
# documented in system_pipeline.txt.
# Unattended local data updates: conservative raw-input ceiling per run.
# Scheduler time/provider/catalog are set by register_data_update_task.ps1.
# This is not a daily translation quota or a monetary spending cap.
KAMI_AUTO_UPDATE_MAX_INPUT_CHARS=2000000
